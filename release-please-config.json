{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "last-release-sha": "790ebcc1988fb88e5a7b38087cc40f86b556d48a",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "portfolio",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false,
      "tag-separator": "-",
      "bump-minor-pre-major": true,
      "draft": false,
      "prerelease": false,
      "extra-files": [
        {
          "type": "json",
          "path": "frontend/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "frontend/package-lock.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "frontend/package-lock.json",
          "jsonpath": "$.packages['']['version']"
        },
        {
          "type": "json",
          "path": "backend/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "backend/package-lock.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "backend/package-lock.json",
          "jsonpath": "$.packages['']['version']"
        }
      ]
    }
  },
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "deps",
      "section": "Dependencies"
    },
    {
      "type": "infra",
      "section": "Infrastructure"
    },
    {
      "type": "docs",
      "section": "Documentation",
      "hidden": false
    },
    {
      "type": "refactor",
      "section": "Refactoring"
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Chores",
      "hidden": true
    }
  ]
}
